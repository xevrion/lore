# Copy to .dev.vars for local development. `node scripts/setup.ts` fills this in.
TOTP_SECRET=
# Optional Discord sign-in. Set both, and DISCORD_CLIENT_ID in wrangler.jsonc for production.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Optional: MEMBER_SIGNUP=open lets any Discord account join as a member pending approval;
# DISCORD_GUILD_ID additionally requires membership of that server.
# MEMBER_SIGNUP=open
# DISCORD_GUILD_ID=
